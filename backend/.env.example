# Copy to backend/.env and fill in. Never commit .env.

# --- Used by the running app (also set these on Render) ---
# The RESTRICTED role, via the Supabase Session pooler (not the direct connection).
# Supabase format: postgresql://support_app.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=postgresql://support_app:CHANGE_ME@localhost:5432/support_dev
# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_MINUTES=30
# Comma-separated exact URLs. Never "*".
CORS_ORIGINS=http://localhost:3000
# "production" on Render (turns on HSTS and hides /docs)
ENVIRONMENT=development

# --- Local only: NEVER set these on Render ---
# Owner connection, used only by create_staff.py
ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/support_dev

# Tests (real PostgreSQL; the database name must contain "test")
TEST_DATABASE_URL=postgresql://support_app:CHANGE_ME@localhost:5432/support_test
TEST_ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/support_test
